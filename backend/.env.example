# ── Database ─────────────────────────────────────────────────────────────────
# Local:       postgresql://pw_user:pw_pass@localhost:5432/pricewise
# Neon (prod): postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://pw_user:pw_pass@localhost:5432/pricewise

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local:            redis://localhost:6379
# Redis Cloud TLS:  rediss://default:pass@redis-xxx.c1.cloud.redislabs.com:6380
REDIS_URL=redis://localhost:6379

# ── AI / LLM ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Vector DB ─────────────────────────────────────────────────────────────────
PINECONE_API_KEY=...
PINECONE_INDEX=pricewise-reviews

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BETTER_AUTH_SECRET=...
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
JWT_ALGORITHM=HS256

# ── Payment ───────────────────────────────────────────────────────────────────
LEMON_SQUEEZY_API_KEY=...
LEMON_SQUEEZY_WEBHOOK_SECRET=...
LEMON_SQUEEZY_STORE_ID=...
LS_VARIANT_PRO=...
LS_VARIANT_BUSINESS=...

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=PriceWise AI <alerts@yourdomain.com>

# ── App ───────────────────────────────────────────────────────────────────────
# Production: set to your Vercel frontend URL
APP_URL=http://localhost:3000
# Comma-separated extra CORS origins (leave empty for local, set in Render)
# Example: https://pricewise.vercel.app,https://www.pricewise.app
CORS_ORIGINS=

# ── Scraper ───────────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true

# ── MLflow (local/dev only) ───────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── AWS (only for model training, not runtime) ────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=pricewise-artifacts

# ── LangSmith (observability for LangChain/LangGraph) ────────────────────────
# Get key: https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=pricewise-ai
