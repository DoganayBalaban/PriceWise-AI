# ── App URLs ──────────────────────────────────────────────────────────────────
# Local:  http://localhost:3000
# Prod:   https://pricewise.vercel.app  (your Vercel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local:  http://localhost:8000
# Prod:   https://pricewise-api.onrender.com  (your Render URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Better Auth ───────────────────────────────────────────────────────────────
# Must be identical to BETTER_AUTH_SECRET in backend
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BETTER_AUTH_SECRET=...

# ── Database (Better Auth reads directly) ────────────────────────────────────
# Same Neon URL as backend
DATABASE_URL=postgresql://pw_user:pw_pass@localhost:5432/pricewise

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
